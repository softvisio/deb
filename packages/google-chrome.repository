#!/usr/bin/env -S bash
# vim: ft=sh

NAME=google-chrome.repository
DESCRIPTION="Google Chrome official repository"
EPOCH=0
VERSION=1.0.0
REVISION=0
ARCHITECTURE=all
DEPENDS=

function build() {
    apt-get install -y gpg

    mkdir -p $DESTDIR/usr/share/keyrings
    curl -fsSL https://dl-ssl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o $DESTDIR/usr/share/keyrings/google-chrome.repository.gpg

    mkdir -p $DESTDIR/etc/apt/sources.list.d
    cat << EOF > $DESTDIR/etc/apt/sources.list.d/google-chrome.list
deb [signed-by=/usr/share/keyrings/google-chrome.repository.gpg] https://dl.google.com/linux/chrome/deb/ stable main
EOF
}
