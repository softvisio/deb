#!/usr/bin/env -S bash
# vim: ft=sh

NAME=vivaldi.repository
DESCRIPTION="Vivaldi official repository"
EPOCH=0
VERSION=1.0.0
REVISION=0
ARCHITECTURE=all
DEPENDS=

function build() {
    apt-get install -y gpg

    mkdir -p $DESTDIR/usr/share/keyrings
    curl -fsSL https://repo.vivaldi.com/archive/linux_signing_key.pub | gpg --dearmor -o $DESTDIR/usr/share/keyrings/vivaldi.gpg

    mkdir -p $DESTDIR/etc/apt/sources.list.d
    cat << EOF > $DESTDIR/etc/apt/sources.list.d/vivaldi.list
deb [arch=amd64,armhf signed-by=/usr/share/keyrings/vivaldi.gpg] https://repo.vivaldi.com/archive/deb stable main
EOF
}
