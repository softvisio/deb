#!/usr/bin/env -S bash
# vim: ft=sh

NAME=git.repository
DESCRIPTION="Git official repository"
EPOCH=0
VERSION=1.0.0
REVISION=0
ARCHITECTURE=all
DEPENDS=

# NOTE: https://launchpad.net/~git-core/+archive/ubuntu/ppa
FINGERPRINT=F911AB184317630C59970973E363C90F8F1B6217

function build() {
    cat << EOF > $DEBIAN/postinst
#!/usr/bin/env -S bash

VERSION_CODENAME=\$(source /etc/os-release && echo \$VERSION_CODENAME)

sed -i -e "/ARCH/ s/ARCH/\$(dpkg --print-architecture)/" /etc/apt/sources.list.d/git.list
sed -i -e "/VERSION_CODENAME/ s/VERSION_CODENAME/\$VERSION_CODENAME/" /etc/apt/sources.list.d/git.list
EOF
    chmod +x $DEBIAN/postinst

    # install
    apt-get install -y gpg

    mkdir -p $DESTDIR/usr/share/keyrings
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${FINGERPRINT}" | gpg --dearmor -o $DESTDIR/usr/share/keyrings/git.gpg

    mkdir -p $DESTDIR/etc/apt/sources.list.d
    cat << EOF > $DESTDIR/etc/apt/sources.list.d/git.list
deb [arch=ARCH signed-by=/usr/share/keyrings/git.gpg] https://ppa.launchpadcontent.net/git-core/ppa/ubuntu VERSION_CODENAME main
EOF
}
