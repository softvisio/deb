#!/usr/bin/env -S bash
# vim: ft=sh

NAME=git-lfs.repository
DESCRIPTION="Git LFS official repository"
EPOCH=0
VERSION=1.0.0
REVISION=0
ARCHITECTURE=all
DEPENDS=

function build() {
    cat << EOF > $DEBIAN/postinst
#!/usr/bin/env -S bash

VERSION_CODENAME=\$(source /etc/os-release && echo \$VERSION_CODENAME)

sed -i -e "/VERSION_CODENAME/ s/VERSION_CODENAME/\$VERSION_CODENAME/" /etc/apt/sources.list.d/git-lfs.list
EOF
    chmod +x $DEBIAN/postinst

    # install
    apt-get install -y gpg

    mkdir -p $DESTDIR/usr/share/keyrings
    curl -fsSL "https://packagecloud.io/github/git-lfs/gpgkey" | gpg --dearmor -o $DESTDIR/usr/share/keyrings/git-lfs.repository.gpg

    mkdir -p $DESTDIR/etc/apt/sources.list.d
    cat << EOF > $DESTDIR/etc/apt/sources.list.d/git-lfs.list
deb [signed-by=/usr/share/keyrings/git-lfs.repository.gpg] https://packagecloud.io/github/git-lfs/ubuntu/ VERSION_CODENAME main

# deb-src [signed-by=/usr/share/keyrings/git-lfs.repository.gpg] https://packagecloud.io/github/git-lfs/ubuntu/ VERSION_CODENAME main
EOF
}
